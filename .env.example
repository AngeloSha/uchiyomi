# Quick start needs NO edits here: `docker compose up -d`, open the app, and create your admin in the browser.
# This file is only for customizing/hardening. Copy to .env to change anything. Never commit .env (it holds secrets).

# --- secrets (all optional) ---
# Internal-only Postgres password (the DB has no host port). Defaults to a fixed value; set your own to harden.
DB_PASSWORD=
# Signs sessions. Leave blank and the app generates one and persists it to /config on first boot.
JWT_SECRET=
# OPTIONAL legacy pre-seed of the admin (base64 argon2id hash; plaintext never stored). Leave blank and create the
# admin in the browser on first run. setup.sh can fill this if you prefer a CLI-seeded admin.
INITIAL_USER_PASSWORD_HASH_B64=
# Web-push (new-chapter notifications) — setup.sh fills these via `web-push generate-vapid-keys`. Leave blank to
# disable push. VAPID_SUBJECT can be a mailto: or https: contact URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@uchiyomi.com

# --- content backend ---
# 'owned' = serve from your own CBZ library (bring-your-own, no Komga). 'komga' = read from a Komga server.
LIBRARY_BACKEND=owned
LIBRARY_PATH=./library            # host path to your CBZ library (read-only), mounted at /library
# Komga (only if LIBRARY_BACKEND=komga):
# KOMGA_BASE_URL=http://komga:25600
# KOMGA_API_KEY=

# --- where the app is published ---
# Both compose files publish the app on WEB_PORT and default to 8080. Left commented on purpose: an
# uncommented value here wins over the compose default, which is how these two drifted apart before.
# Uncomment only to change them, and change them together — PUBLIC_ORIGIN must match the port you serve on,
# or cookies and CORS break.
# WEB_PORT=8080                   # host port for the app -> http://localhost:${WEB_PORT}
# PUBLIC_ORIGIN=http://localhost:8080   # match your domain when behind a reverse proxy
# SPLIT_WEB_PORT=8081             # only used by `docker compose --profile split`

# --- source plugins (optional) ---
# Path to a built source pack (compiled .js) mounted read-only at /sources. Leave as the empty ./sources dir
# to run a clean, scraper-free reader. Nothing is published to drop in here; the loader will register any
# compiled CommonJS plugin you build yourself against the contract in bff/src/lib/sources/loader.ts.
SOURCES_PATH=./sources

# --- extension engine (optional) ---
# Mihon/Tachiyomi extensions run on the bundled Suwayomi container; the app configures itself to talk to it.
# Leave these alone for the bundled engine. Set SUWAYOMI_URL= (empty) to turn the feature off entirely, or
# point it at a Suwayomi you already run. See docs/extensions.md.
# SUWAYOMI_URL=http://yomi-suwayomi:4567
# SUWAYOMI_USERNAME=              # only if your engine has authentication switched on
# SUWAYOMI_PASSWORD=
# SUWAYOMI_MAX_SOURCES=25         # ceiling on how many extension sources register at once

# --- backups (optional) ---
# Nightly DB + config backup. Defaults to a Docker volume; point this at a host directory — ideally on a
# DIFFERENT physical disk than your Docker volumes — to keep backups if that drive dies.
# The dir must be writable by uid 10002:  docker run --rm -v /mnt/backups:/b alpine chown 10002:10002 /b/uchiyomi
# BACKUP_PATH=/mnt/backups/uchiyomi
# BACKUP_KEEP=14

# --- tuning (optional; every one of these has a sensible default) ---
# None of these need setting on a normal install. They are here because docs/CONFIGURATION.md calls this
# file the authoritative list, and for a long time it was not: the changelog named several of these by hand
# while they appeared in no file anyone reads. Defaults shown are the real ones from bff/src.
#
# Fetching and the Cloudflare solver
# FLARESOLVERR_URL=http://yomi-flaresolverr:8191
# SOLVER_CONCURRENCY=4            # how many challenge solves may run at once
# SOLVER_BUDGET_MS=90000          # time budget for a source that needs the solver (90s)
#
# The scheduled update sweep
# UPDATER_SWEEP_MAX=150           # chapter-fetch attempts per sweep, so a backlog cannot run all night
# UPDATER_LIST_TIMEOUT_MS=20000   # give up on one source's chapter list after this
# CHAPTER_RETRY_CAP=3             # stop retrying a chapter that keeps failing
#
# Downloading
# DOWNLOAD_CONCURRENCY=2          # chapters at once
# DOWNLOAD_PAGE_GAP_MS=250        # pause between page requests, to stay polite to a source
# DOWNLOAD_MIN_GAP_MS=1200        # minimum gap between requests to the same host
# MIN_FREE_GB=10                  # refuse to download when the disk falls below this
#
# Library scanning and matching
# LIBRARY_MAX_DEPTH=6             # how deep to look for a folder that directly contains chapters
# SCAN_CONCURRENCY=               # defaults to SOLVER_CONCURRENCY
# SCAN_ENOUGH=3                   # candidate matches that count as enough when filling gaps
# SCAN_SEARCH_MS=45000            # per-source budget while searching for a missing chapter
# LIBRARY_REMATCH=off             # off | report | apply — see docs/CONFIGURATION.md
#
# The opt-in install count (Admin -> Settings; off unless you turn it on there)
# UCHIYOMI_PING_URL=              # defaults to https://uchiyomi.com/api/hello; set empty to hard-disable
