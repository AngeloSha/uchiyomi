# Copy to .env and run `bash scripts/setup.sh` (it fills in the generated secrets + your login password).
# Never commit .env — it holds secrets.

# --- generated by setup.sh if blank (openssl rand) ---
DB_PASSWORD=
JWT_SECRET=
# argon2id hash of your app login password, base64-encoded (setup.sh writes this; plaintext never stored)
INITIAL_USER_PASSWORD_HASH_B64=

# --- content backend ---
# 'owned' = serve from your own CBZ library (bring-your-own, no Komga). 'komga' = read from a Komga server.
LIBRARY_BACKEND=owned
LIBRARY_PATH=./library            # host path to your CBZ library (read-only), mounted at /library
# Komga (only if LIBRARY_BACKEND=komga):
# KOMGA_BASE_URL=http://komga:25600
# KOMGA_API_KEY=

# --- public URL the app is served from (for cookies/CORS) ---
PUBLIC_ORIGIN=http://localhost:3000

# --- source plugins (optional) ---
# Path to a built source pack (compiled .js) mounted read-only at /sources. Leave as the empty ./sources dir
# to run a clean, scraper-free reader. See the separate yomi-sources project to build one.
SOURCES_PATH=./sources
