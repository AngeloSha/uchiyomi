{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "rootDir": "..",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"]
  },
  "include": ["main.ts", "../desktop/src/solver/*.ts", "../desktop/test/solver.electron.test.ts"]
}
